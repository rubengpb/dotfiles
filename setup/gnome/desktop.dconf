[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.freedesktop.GnomeAbrt.desktop', 'org.gnome.SystemMonitor.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Connections.desktop', 'org.gnome.Evince.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
picture-options='zoom'
picture-uri='file:///home/rgpb/dotfiles/wallpapers/gnome-lune-dark.jpg'
picture-uri-dark='file:///home/rgpb/dotfiles/wallpapers/gnome-lune-dark.jpg'

[break-reminders/eyesight]
play-sound=true

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=true

[input-sources]
current=uint32 0
mru-sources=[('xkb', 'es'), ('xkb', 'us')]
sources=[('xkb', 'es'), ('xkb', 'us')]
xkb-options=['caps:swapescape', 'lv3:ralt_switch', 'compose:rctrl']

[interface]
color-scheme='prefer-dark'
enable-animations=false
enable-hot-corners=false

[notifications]
application-children=['org-mozilla-firefox', 'org-gnome-nautilus', 'org-gnome-software', 'gnome-power-panel', 'org-gnome-ptyxis', 'org-pwmt-zathura', 'com-mattjakeman-extensionmanager', 'org-gnome-settings', 'org-gnome-clocks', 'gnome-printers-panel', 'gnome-about-panel', 'org-gnome-rhythmbox3', 'org-freedesktop-problems-applet', 'org-gnome-totem', 'code', 'alacritty', 'com-spotify-client', 'org-gnome-evince', 'com-brave-browser']
show-banners=true

[notifications/application/alacritty]
application-id='Alacritty.desktop'

[notifications/application/code]
application-id='code.desktop'

[notifications/application/com-brave-browser]
application-id='com.brave.Browser.desktop'

[notifications/application/com-mattjakeman-extensionmanager]
application-id='com.mattjakeman.ExtensionManager.desktop'

[notifications/application/com-spotify-client]
application-id='com.spotify.Client.desktop'

[notifications/application/gnome-about-panel]
application-id='gnome-about-panel.desktop'

[notifications/application/gnome-power-panel]
application-id='gnome-power-panel.desktop'

[notifications/application/gnome-printers-panel]
application-id='gnome-printers-panel.desktop'

[notifications/application/org-freedesktop-problems-applet]
application-id='org.freedesktop.problems.applet.desktop'

[notifications/application/org-gnome-clocks]
application-id='org.gnome.clocks.desktop'

[notifications/application/org-gnome-evince]
application-id='org.gnome.Evince.desktop'

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[notifications/application/org-gnome-ptyxis]
application-id='org.gnome.Ptyxis.desktop'

[notifications/application/org-gnome-rhythmbox3]
application-id='org.gnome.Rhythmbox3.desktop'

[notifications/application/org-gnome-settings]
application-id='org.gnome.Settings.desktop'

[notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'

[notifications/application/org-gnome-totem]
application-id='org.gnome.Totem.desktop'

[notifications/application/org-mozilla-firefox]
application-id='org.mozilla.firefox.desktop'

[notifications/application/org-pwmt-zathura]
application-id='org.pwmt.zathura.desktop'

[peripherals/keyboard]
numlock-state=true

[peripherals/mouse]
accel-profile='default'
speed=1.0

[peripherals/touchpad]
send-events='enabled'
two-finger-scrolling-enabled=true

[privacy]
report-technical-problems=true

[remote-desktop/rdp]
enable=false
tls-cert='/home/rgpb/.local/share/gnome-remote-desktop/certificates/rdp-tls.crt'
tls-key='/home/rgpb/.local/share/gnome-remote-desktop/certificates/rdp-tls.key'
view-only=true

[search-providers]
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Nautilus.desktop']

[session]
idle-delay=uint32 0

[sound]
event-sounds=true
theme-name='__custom'

[wm/keybindings]
close=['<Super>c']
maximize=['<Super>r']
move-to-workspace-1=['<Shift><Super>u']
move-to-workspace-2=['<Shift><Super>i']
move-to-workspace-3=['<Shift><Super>o']
move-to-workspace-4=['<Shift><Super>k']
move-to-workspace-last=['<Shift><Super>l']
switch-applications=['<Alt>less']
switch-applications-backward=['<Shift><Alt>less']
switch-to-workspace-1=['<Super>u']
switch-to-workspace-2=['<Super>i']
switch-to-workspace-3=['<Super>o']
switch-to-workspace-4=['<Super>k']
switch-to-workspace-last=['<Super>l']
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']

[wm/preferences]
num-workspaces=5
workspace-names=@as []
